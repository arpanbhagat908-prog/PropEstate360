# ─── SERVER ─────────────────────────────────────────────────────────────────
PORT=3001

# ─── JWT ─────────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_in_production_min_32_chars

# ─── ADMIN ACCOUNT ───────────────────────────────────────────────────────────
ADMIN_NAME=Arpan
ADMIN_EMAIL=arpan@propestate360.com
ADMIN_PASSWORD=Secure123
ADMIN_PHONE=xxxxxxxx

# ─── EMAIL (Gmail SMTP for real OTP delivery) ────────────────────────────────
# Steps to get Gmail App Password:
#  1. Go to your Google Account → Security → Enable 2-Step Verification
#  2. Search "App passwords" → Create one → Select "Mail" and "Other"
#  3. Paste the 16-character code below (no spaces)
# If not configured, OTPs will only appear in server console (dev mode).
GMAIL_USER=xxxxxxxxxx@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxx

# ─── DATABASE ────────────────────────────────────────────────────────────────
DB_PATH=./data/propestate360.db

# ─── FRONTEND URL (for CORS) ─────────────────────────────────────────────────
# Set this to your Vercel deployment URL in production
# e.g. https://your-app-name.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── NOTES FOR RENDER DEPLOYMENT ────────────────────────────────────────────
# 1. Set all the above env vars in Render Dashboard → Environment
# 2. Photos are now stored as base64 in the database (no disk needed)
# 3. The SQLite database is stored in ./data/ - consider adding a Render Disk
#    if you want data to persist across deploys (optional for free tier)
